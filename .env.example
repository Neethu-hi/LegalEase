# ==========================================
# LegalEase Environment Configuration
# ==========================================

# Server Port (default: 3000)
PORT=3000

# NVIDIA Build API Key for DeepSeek (from https://build.nvidia.com)
# Formatted as: nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_API_KEY=

# DeepSeek Model on NVIDIA NIM:
# Options:
#   deepseek-ai/deepseek-r1 (Flagship reasoning model with chain-of-thought analysis)
#   deepseek-ai/deepseek-v3 (Fast, high-throughput contract analysis)
NVIDIA_MODEL=deepseek-ai/deepseek-r1

# NVIDIA NIM Base URL (OpenAI-compatible endpoint)
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Preferred AI Provider: 'nvidia', 'openai', or 'dynamic' (auto-detected if blank)
AI_PROVIDER=nvidia

# (Optional) OpenAI API Key fallback
OPENAI_API_KEY=
